// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// xcconfig treats "//" as a comment start, even inside a URL, so escape it
// with $() when a value contains one: https:/$()/xyz.supabase.co

SUPABASE_URL = https:/$()/xyz.supabase.co
SUPABASE_ANON_KEY = replace-me

REVENUECAT_APPLE_API_KEY = replace-me
REVENUECAT_PLUS_PRODUCT_ID = com.immform.relora.plus.monthly
REVENUECAT_PRO_PRODUCT_ID = com.immform.relora.pro.monthly
REVENUECAT_PLUS_ENTITLEMENT_ID = Relora Plus
REVENUECAT_PRO_ENTITLEMENT_ID = Relora Pro
